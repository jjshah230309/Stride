<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light only, like the iPhone app. Compose draws everything; this just colours the window. -->
    <style name="Theme.Stride" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
