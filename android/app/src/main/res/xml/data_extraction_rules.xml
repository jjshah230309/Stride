<?xml version="1.0" encoding="utf-8"?>
<!-- Stride keeps its own backup format (Data > Back up now). Android's cloud and device-transfer
     copies are switched off so training data only moves where the user sends it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
